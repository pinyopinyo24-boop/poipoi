# Hybrid Local/Cloud Configuration
# Add these to your .env file or set as environment variables

# Local Server Configuration
LOCAL_SERVER_URL=http://localhost:3000

# Cloud Server Configuration  
CLOUD_SERVER_URL=https://poipoi.manus.space

# Hybrid Connection Mode
# Options: auto, local-only, cloud-only
# auto: Try local first, failover to cloud if local unavailable
# local-only: Use only local server
# cloud-only: Use only cloud server
HYBRID_MODE=auto

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
MAX_RETRIES=3

# Sync Configuration
AUTO_SYNC=true
SYNC_INTERVAL=60000
SYNC_CONFLICT_RESOLUTION=merge

# Feature Flags
ENABLE_LOCAL_SERVER=true
ENABLE_CLOUD_SERVER=true
ENABLE_AUTO_FAILOVER=true
